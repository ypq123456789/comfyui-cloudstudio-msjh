{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动墨色江湖 Cloud Studio ComfyUI 后端",
      "type": "shell",
      "command": "bash cloudstudio_start.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    }
  ]
}
