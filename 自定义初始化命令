# ============================================================
# 预设工作流模型预下载 - 避免首次点击生图时再等待模型拉取
# ============================================================

CUSTOM_DOWNLOADS="/workspace/自定义下载链接.yaml"
MODEL_CACHE_DIR="/workspace/models_cnb_cache"
MODEL_LINK_DIR="/workspace/models"

resolve_model_relpath() {
    local model_path="$1"
    model_path="${model_path%\"}"
    model_path="${model_path#\"}"
    model_path="${model_path%\'}"
    model_path="${model_path#\'}"
    case "$model_path" in
        /workspace/comfyui/models/*)
            model_path="${model_path#/workspace/comfyui/models/}"
            ;;
        /workspace/models/*)
            model_path="${model_path#/workspace/models/}"
            ;;
        models/*)
            model_path="${model_path#models/}"
            ;;
    esac
    model_path="${model_path#./}"
    echo "$model_path"
}

is_model_ready() {
    local target="$1"
    local cache="$2"
    if [ -L "$target" ] && [ -s "$(readlink -f "$target" 2>/dev/null)" ]; then
        return 0
    fi
    if [ -s "$target" ] || [ -s "$cache" ]; then
        return 0
    fi
    return 1
}

link_cached_model() {
    local rel_path="$1"
    local cache="$2"
    local target="$MODEL_LINK_DIR/$rel_path"
    local comfy_target="/workspace/comfyui/models/$rel_path"

    mkdir -p "$(dirname "$target")"
    ln -sfn "$cache" "$target"

    if [ -d /workspace/comfyui/models ] && [ "$comfy_target" != "$target" ]; then
        mkdir -p "$(dirname "$comfy_target")"
        ln -sfn "$cache" "$comfy_target"
    fi
}

download_model_if_needed() {
    local model_path="$1"
    local url="$2"
    local rel_path cache cache_dir cache_name

    rel_path="$(resolve_model_relpath "$model_path")"
    if [ -z "$rel_path" ] || [ -z "$url" ]; then
        return 0
    fi

    cache="$MODEL_CACHE_DIR/$rel_path"
    cache_dir="$(dirname "$cache")"
    cache_name="$(basename "$cache")"

    if is_model_ready "$MODEL_LINK_DIR/$rel_path" "$cache"; then
        if [ -s "$cache" ]; then
            link_cached_model "$rel_path" "$cache"
        fi
        echo "[Model Prefetch] 已存在，跳过: $rel_path"
        return 0
    fi

    mkdir -p "$cache_dir"
    echo "[Model Prefetch] 正在下载: $rel_path"
    if command -v aria2c >/dev/null 2>&1; then
        if aria2c -x 8 -s 8 -c -d "$cache_dir" -o "$cache_name" "$url"; then
            link_cached_model "$rel_path" "$cache"
            echo "[Model Prefetch] 下载完成: $rel_path"
        else
            echo "[Model Prefetch] 警告: 下载失败，启动后仍可由界面自动下载: $rel_path"
        fi
    elif command -v curl >/dev/null 2>&1; then
        if curl -L --retry 3 --continue-at - -o "$cache" "$url"; then
            link_cached_model "$rel_path" "$cache"
            echo "[Model Prefetch] 下载完成: $rel_path"
        else
            rm -f "$cache"
            echo "[Model Prefetch] 警告: 下载失败，启动后仍可由界面自动下载: $rel_path"
        fi
    else
        echo "[Model Prefetch] 警告: 未找到 aria2c/curl，跳过预下载"
    fi
}

if [ -f "$CUSTOM_DOWNLOADS" ]; then
    echo "[Model Prefetch] 正在预下载预设工作流模型..."
    while IFS=$'\t' read -r model_path url; do
        download_model_if_needed "$model_path" "$url"
    done < <("$PYTHON_BIN" - "$CUSTOM_DOWNLOADS" <<'PY'
import re
import sys

path = sys.argv[1]
with open(path, "r", encoding="utf-8-sig") as fh:
    for raw in fh:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        match = re.match(r'^(?P<path>"[^"]+"|\'[^\']+\'|.*?):\s+(?P<url>https?://\S+)\s*$', line)
        if not match:
            continue
        print(f"{match.group('path')}\t{match.group('url')}")
PY
)
    echo "[Model Prefetch] 预设模型检查完成"
fi

# ============================================================
# 墨色江湖工作流与默认打开页 - 同步到 ComfyUI 实际用户目录并自动载入默认工作流
