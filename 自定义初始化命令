}}

app.registerExtension({{
  name: "MoRanJiangHu.DefaultWorkflow",
  async setup() {{
    setTimeout(loadMoRanDefaultWorkflow, 800);
    setTimeout(loadMoRanDefaultWorkflow, 2000);
  }},
}});
'''

out_path.write_text(js, encoding="utf-8")
PY
    echo "[MoRan Workflow] 已安装默认工作流自动载入扩展"
fi

