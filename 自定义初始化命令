# ============================================================
# ComfyUI 前端版本兜底 - 修复 Backend 要求 1.43.18+ 但镜像仍是旧前端的问题
# ============================================================

FRONTEND_UPDATE_NEEDED="$("$PYTHON_BIN" - <<'PY'
import re
from importlib import metadata

def version_tuple(value):
    nums = [int(x) for x in re.findall(r"\d+", value)[:3]]
    while len(nums) < 3:
        nums.append(0)
    return tuple(nums)

try:
    installed = metadata.version("comfyui-frontend-package")
except metadata.PackageNotFoundError:
    installed = "0.0.0"

print("yes" if version_tuple(installed) < (1, 43, 18) else "no")
