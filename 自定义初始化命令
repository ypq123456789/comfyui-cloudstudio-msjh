#!/bin/bash

# 将需要在初始化阶段执行的bash命令写在这里，一个命令一行，环境启动后会自动按顺序执行
# 例如：
# aria2c -x 4 -s 4 -c -d "/workspace/models/checkpoints" -o "ace_step_v1_3.5b.safetensors" "https://cnb.cool/ai-models/Comfy-Org/ACE-Step_ComfyUI_repackaged/-/lfs/f07cad74c4adce52ca14ca1bdf74cf3c14cbafb0823b95eca4459467fa369f40"
# 启动CNB域名持续上报（后台运行）
nohup bash /workspace/cnb_sync.sh > /tmp/cnb_sync.log 2>&1 &

# 禁用NSFW检测：用stub模块替代原始.so（每次启动自动构建）
# 注意：直接删除 .so 会导致"核心模块缺失"错误，需要用stub替换
STUB_DIR="/workspace/.cnb-xu/script_py"
STUB_PY="$STUB_DIR/nsfw_checker_by_xu.py"
STUB_SO="$STUB_DIR/nsfw_checker_by_xu.cpython-312-x86_64-linux-gnu.so"
if [ -d "$STUB_DIR" ]; then
  cat > "$STUB_PY" << 'STUBEOF'
import numpy as np
import torch
class NSFW_Content_Found(Exception):
    def __init__(self, msg="NSFW Content Found !"):
        super().__init__(msg)
def check_image(image, *a, **kw): return False
def check_vae_decode_images(images, *a, **kw): return images
def detect_nsfw(image, *a, **kw): return False
def detect_with_nsfw_1(image, *a, **kw): return False
def detect_with_nsfw_2(image, *a, **kw): return False
def detect_with_nsfw_3(image, *a, **kw): return False
def prepare_detect_frame(image, *a, **kw): return image
def fit_frame(image, *a, **kw): return image
def forward_nsfw(image, *a, **kw): return False
class NSFW_Checker:
    @classmethod
    def INPUT_TYPES(s):
        return {"required": {"image": ("IMAGE", {"tooltip": "The images to check."})}, "hidden": {"prompt": "PROMPT", "extra_pnginfo": "EXTRA_PNGINFO"}}
    RETURN_TYPES = ("IMAGE",)
    FUNCTION = "save_images"
    OUTPUT_NODE = True
    CATEGORY = "CNB-Xu"
    DESCRIPTION = "NSFW Checker (disabled)"
    def save_images(self, image, prompt=None, extra_pnginfo=None):
        return {"ui": {}, "result": (image,)}
NODE_CLASS_MAPPINGS = {"NSFW_Checker": NSFW_Checker}
STUBEOF
  python3 -c "
from Cython.Build import cythonize
from setuptools import Extension, Distribution
ext = Extension('nsfw_checker_by_xu', sources=['$STUB_PY'])
dist = Distribution({'ext_modules': cythonize([ext], language_level=3)})
cmd = dist.get_command_obj('build_ext')
cmd.build_lib = '$STUB_DIR'
cmd.inplace = True
cmd.ensure_finalized()
cmd.run()
" 2>/dev/null
  rm -f "$STUB_DIR/nsfw_checker_by_xu.c"
  echo "NSFW checker stub built and replaced"
  # 修改 patch_by_xu.py，在 patch_nodes() 后注入禁用 NSFW 的代码
  sed -i 's/    patch_nodes()\n    if args.auto_launch:/    patch_nodes()\n    import hook2_by_xu\n    hook2_by_xu.enable_check = False\n    if args.auto_launch:/' "$STUB_DIR/patch_by_xu.py" 2>/dev/null
  # 用python做更可靠的替换
  python3 -c "
p='$STUB_DIR/patch_by_xu.py'
import os
if os.path.exists(p):
    with open(p,'r') as f: c=f.read()
    old='    patch_nodes()\n    if args.auto_launch:'
    new='    patch_nodes()\n    import hook2_by_xu\n    hook2_by_xu.enable_check = False\n    if args.auto_launch:'
    if old in c and 'enable_check' not in c:
        c=c.replace(old,new)
        with open(p,'w') as f: f.write(c)
        print('patch_by_xu.py patched: NSFW disabled')
    elif 'enable_check' in c:
        print('patch_by_xu.py already has NSFW disable')
    else:
        print('patch_by_xu.py: pattern not found')
" 2>/dev/null
fi

# 安装Tencent Cloud CodeBuddy扩展
code-server --install-extension Tencent-Cloud.coding-copilot
