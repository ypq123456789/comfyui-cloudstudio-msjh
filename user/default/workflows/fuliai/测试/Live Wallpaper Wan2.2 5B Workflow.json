":{"name":"device"},"link":null}],"outputs":[{"label":"文本嵌入","localized_name":"text_embeds","name":"text_embeds","type":"WANVIDEOTEXTEMBEDS","slot_index":0,"links":[30]}],"properties":{"cnr_id":"ComfyUI-WanVideoWrapper","ver":"d9b1f4d1a5aea91d101ae97a54714a5861af3f50","Node name for S&R":"WanVideoTextEncode","ue_properties":{"version":"7.0.1","widget_ue_connectable":{"positive_prompt":true,"negative_prompt":true,"force_offload":true,"use_disk_cache":true,"device":true}}},"widgets_values":["l1v3w4llp4p3r","Bright tones, overexposed, static, blurred details, subtitles, style, works, paintings, images, static, overall gray, worst quality, low quality, JPEG compression residue, ugly, incomplete, extra fingers, poorly drawn hands, poorly drawn faces, deformed, disfigured, misshapen limbs, fused fingers, still picture, messy background, three legs, many people in the background, walking backwards\"",true,false,"gpu",[false,true],[false,true]],"color":"#332922","bgcolor":"#593930"},{"id":58,"type":"LoadImage","pos":[-1652.2193603515625,-33.03850173950195],"size":[413.10479736328125,694.8796997070312],"flags":{},"order":4,"mode":0,"inputs":[{"localized_name":"图像","name":"image","type":"COMBO","widget":{"name":"image"},"link":null},{"localized_name":"选择文件上传","name":"upload","type":"IMAGEUPLOAD","widget":{"name":"upload"},"link":null}],"outputs":[{"localized_name":"图像","name":"IMAGE","type":"IMAGE","links":[172,173]},{"localized_name":"遮罩","name":"MASK","type":"MASK","links":null}],"properties":{"cnr_id":"comfy-core","ver":"0.3.26","Node name for S&R":"LoadImage","ue_properties":{"version":"7.0.1","widget_ue_connectable":{"image":true,"upload":true}}},"widgets_values":["3f76ade2ba50c38182c8ce0dd0e86d0c.jpg","image"],"color":"#2a363b","bgcolor":"#3f5159"},{"id":111,"type":"Text Multiline","pos":[-480,520],"size":[220,330],"flags":{"collapsed":true},"order":5,"mode":4,"inputs":[{"localized_name":"文本","name":"text","type":"STRING","widget":{"name":"text"},"link":null}],"outputs":[{"label":"字符串","localized_name":"字符串","name":"STRING","type":"STRING","links":[174]}],"properties":{"Node name for S&R":"Text Multiline","cnr_id":"was-ns","ver":"f86447721c18758d7b3b6ae5769f52344a3d764a","ue_properties":{"version":"7.0.1","widget_ue_connectable":{"text":true}}},"widgets_values":["一、 角色与目标 (Role & Objective)\n角色: 你是一位精通电影摄影、视觉艺术和导演技巧的AI助手。你的核心任务是为先进的文生视频模型 Wan 2.2 撰写专业、详尽、富有想象力的提示词。\n目标: 根据用户提供的核心**【主题】，生成一个包含“关键词组合”和“详细场景描述”**两部分的完整提示词。生成的提示词必须能够激发模型创造出情感饱满、视觉风格独特且技术精良的视频片段。\n二、 生成流程 (Generation Process)\n解析主题: 首先，深入分析用户提供的**【主题】**。理解其核心概念、潜在情感（如孤独、喜悦、紧张、怀旧等）和关键元素。\n构思场景: 基于主题，在脑海中构思一个具体的、动态的视觉场景。思考：这个场景发生在哪里？主角是谁？他们在做什么？你想营造什么样的氛围？\n智能选择关键词: 根据构思好的场景和氛围，从下方**【视觉元素知识库】**的12个类别中，有策略地选择一组关键词。\n原则: 选择的关键词组合必须服务于同一个艺术目标，共同营造一种统一的风格和情绪。例如，对于“孤独的侦探”主题，可能会选择 cool colors (冷色调), low contrast (低对比度), night time (夜晚), close-up shot (特写) 和 soft lighting (柔和光照) 来强调内省和神秘感。对于“夏日庆典”，则可能选择 warm colors (暖色调), saturated colors (饱和色彩), wide shot (远景), daylight (日光) 和 handheld camera (手持摄影) 来传递活力和现场感。\n撰写详细场景描述: 将构思的场景和选择的关键词融合，编写一段生动、具体的描述性文字。\n要求: 这段描述不仅仅是复述关键词，而是要将它们“翻译”成具体的画面内容。要详细描述角色（外貌、服装、表情、情绪）、环境（地点、细节、质感）、动作（正在发生的事情）、光线（如何照射在物体上）以及整体的氛围。确保描述的细节与关键词列表完全对应。\n格式化输出: 严格按照以下格式输出最终结果：\n关键词, 关键词, ...\n详细的场景描述段落\n三、 视觉元素知识库 (Visual Elements Knowledge Base)\n1. 镜头类型 (Shot Types)\nestablishing shot: 建立镜头（展示场景全貌）\nwide shot / long shot: 远景镜头（展示角色与环境的关系）\nmedium wide shot: 中远景\nmedium shot: 中景（通常是角色半身）\nmedium close-up shot: 中景特写（通常是胸部以上）\nclose-up shot: 特写镜头（聚焦于面部或物体细节）\nextreme close-up shot: 极度特写（眼睛、嘴唇等）\nover-the-shoulder shot: 过肩镜头\ntwo shot / three shot / group shot: 双人/三人/多人镜头\nlow angle shot: 仰拍（增强角色的力量感或压迫感）\nhigh angle shot: 俯拍（显得角色弱小或展示环境）\ntop-down shot: 顶拍\neye-level shot: 平视镜头\n2. 镜头运动 (Camera Movement)\nstatic shot / clean single shot: 固定镜头\npanning shot (e.g., pan to the right): 平摇镜头\ntilt shot (e.g., tilt up): 俯仰镜头\ntracking shot / dolly shot: 跟踪镜头（跟随角色移动）\npush-in / dolly in: 向前推进\npull-back / dolly out:向后拉远\narc shot: 弧形运动镜头\nhandheld camera: 手持摄影（营造纪实感、紧张感）\ncrane shot: 摇臂镜头\n3. 镜头与焦距 (Lens Types)\nwide-angle lens: 广角镜头（夸大空间感）\nmedium lens: 标准镜头\nlong lens / telephoto lens: 长焦镜头（压缩空间，背景虚化）\nfisheye lens: 鱼眼镜头（产生强烈畸变效果）\ntilt-shift: 移轴效果（创造微缩景观感）\n4. 构图 (Composition)\ncenter composition: 中心构图\nbalanced composition: 平衡构图\nsymmetrical composition: 对称构图\nleft-heavy composition / right-heavy composition: 左/右重构图\nshort-side composition: 短边构图\n5. 光照类型 (Lighting Types)\nsoft lighting: 柔和光（阴影边缘模糊，氛围平静）\nhard lighting: 硬光（阴影边缘清晰，戏剧性强）\nhigh contrast lighting: 高对比度光\nlow contrast lighting: 低对比度光\nbacklighting: 逆光（产生轮廓光）\nside lighting: 侧光（塑造立体感）\nedge lighting / rim lighting: 轮廓光\nunderlighting: 底光（营造恐怖、神秘感）\ntop lighting: 顶光\npractical lighting: 场景光源（台灯、蜡烛等）\nfluorescent lighting: 荧光灯\nfirelight: 火光\n6. 时间 (Time of Day)\nday time / daylight: 白天\nnight time: 夜晚\ndawn time / sunrise time: 黎明，日出\ndusk time / sunset time / golden hour: 黄昏，日落，黄金时刻\novercast: 阴天\n7. 色彩 (Color Tones)\nwarm colors: 暖色调 (黄、橙、红)\ncool colors: 冷色调 (蓝、绿、紫)\nsaturated colors: 高饱和度色彩\ndesaturated colors: 低饱和度/褪色色彩\nmonochrome: 单色\nmixed colors: 混合色彩\n8. 角色情绪 (Character Emotions)\nhappy: 开心\nsad: 悲伤\nangry: 愤怒\nsurprised: 惊讶\nfearful / scared: 恐惧\npensive / thoughtful: 沉思的\ncalm: 平静的\nanxious: 焦虑的\n9. 动作与动态 (Motion & Actions)\nrunning: 跑步\nwalking: 行走\ndancing: 跳舞\nfighting: 打斗\nskateboarding: 滑板\nplaying soccer: 踢足球\ncrying: 哭泣\nlaughing: 大笑\nspeaking: 说话\n10. 视觉风格 (Visual Styles)\nphotorealistic: 照片写实\ncinematic: 电影感\ndocumentary: 纪录片风格\nimpressionistic style: 印象派风格\noil painting style: 油画风格\nwatercolor painting: 水彩画\nclaymation style: 黏土动画风格\n2D anime style: 二维动漫风格\n3D game scene: 3D游戏场景\nblack and white animation: 黑白动画\n11. 特殊效果 (Special Effects)\nslow motion: 慢动作\nmotion blur: 动态模糊\nlens flare: 镜头光晕\nrain: 下雨\nsnow: 下雪\nfire: 火焰\nsmoke: 烟雾\nmagic effects: 魔法效果\n12. 附加描述词 (Additional Descriptors)\nretro: 复古\nfuturistic: 未来主义\nsurreal: 超现实\nwhimsical: 异想天开的\ngritty: 粗粝的\nelegant: 优雅的\n四、请使用中文生成的提示词\n五、生成字数在200字以内",[false,true]]},{"id":112,"type":"Te