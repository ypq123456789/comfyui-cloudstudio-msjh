场面。第一位男性摔跤手位于她前方，赤裸的上身肌肉发达，汗水在硬光照射下闪闪发光，短促的黑额因紧张而绷紧。他正试图将手臂环抱住她的腰部。第二位男性摔跤手位于她下方，部分乌黑可见的头发散乱，他正试图从地面限制她的腿部动作。\n\n背景是模糊处理的蓝色场馆座椅和明亮的顶灯，创造出深度感和竞技氛围。强烈的顶光（可能是聚光灯）从上方照射，产生高对比度的光影效果，突出了摔跤手们的肌肉轮廓和汗水的光泽。整个画面充满了动感和力量感，捕捉了摔跤比赛中的紧张瞬间和身体强度。",[false,true]],"color":"#232","bgcolor":"#353"},{"id":40,"type":"CLIPLoader","pos":[4424.0791015625,1525.6739501953125],"size":[360,106],"flags":{},"order":6,"mode":0,"inputs":[{"label":"clip_name","localized_name":"CLIP名称","name":"clip_name","type":"COMBO","widget":{"name":"clip_name"}},{"label":"type","localized_name":"类型","name":"type","type":"COMBO","widget":{"name":"type"}},{"label":"device","localized_name":"设备","name":"device","shape":7,"type":"COMBO","widget":{"name":"device"}}],"outputs":[{"label":"CLIP","localized_name":"CLIP","name":"CLIP","type":"CLIP","slot_index":0,"links":[45,60]}],"properties":{"cnr_id":"comfy-core","ver":"0.3.49","Node name for S&R":"CLIPLoader","ue_properties":{"version":"7.0.1","widget_ue_connectable":{"clip_name":true,"type":true,"device":true}}},"widgets_values":["Wan_Native/umt5_xxl_fp8_e4m3fn_scaled.safetensors","wan","default"],"color":"#223","bgcolor":"#335"},{"id":74,"type":"LoraLoaderModelOnly","pos":[5480,1140],"size":[310,90],"flags":{},"order":17,"mode":0,"inputs":[{"localized_name":"模型","name":"model","type":"MODEL","link":83},{"localized_name":"LoRA名称","name":"lora_name","type":"COMBO","widget":{"name":"lora_name"},"link":null},{"localized_name":"模型强度","name":"strength_model","type":"FLOAT","widget":{"name":"strength_model"},"link":null}],"outputs":[{"localized_name":"模型","name":"MODEL","type":"MODEL","links":[85]}],"properties":{"cnr_id":"comfy-core","ver":"0.3.57","Node name for S&R":"LoraLoaderModelOnly","ue_properties":{"version":"7.0.1","widget_ue_connectable":{"lora_name":true,"strength_model":true}}},"widgets_values":["LightX2V/Native/I2V_low_noise_model.safetensors",1]},{"id":48,"type":"LoraLoaderModelOnly","pos":[5210,1370],"size":[300,90],"flags":{},"order":16,"mode":0,"inputs":[{"l